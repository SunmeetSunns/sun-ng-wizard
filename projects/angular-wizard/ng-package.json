{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/angular-wizard",
  "lib": {
    "entryFile": "src/public-api.ts",
    "cssUrl": "inline",
    "styleIncludePaths": ["../../", "../../scss", "src/scss"]
  },
  "allowedNonPeerDependencies": ["angular-feather", "feather-icons"],
  "assets": [{ "input": "src/scss", "glob": "**/*.scss", "output": "scss" }]
}
